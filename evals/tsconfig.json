{
  // Type-check config for the agent-eval harness (`pnpm typecheck` runs it).
  //
  // `tasks/*/hidden/**` is excluded: those tests are copied into a scaffolded
  // workspace at grading time and import that workspace's `src/build-app.ts`,
  // so they only type-check there (and the calibration run executes them).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["tasks/*/hidden/**", "results/**"]
}
