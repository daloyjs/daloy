{
  "name": "my-daloy-deno-app",
  "tasks": {
    "dev": "DENO_ENV=development deno run --allow-net --allow-env=PORT,DENO_ENV,TRUST_PROXY_HOPS,PUBLIC_URL --watch src/main.ts",
    "start": "deno run --allow-net --allow-env=PORT,DENO_ENV,TRUST_PROXY_HOPS,PUBLIC_URL src/main.ts",
    "typecheck": "deno check src/ tests/ scripts/",
    "test": "deno test --allow-net --allow-env tests/",
    "contract": "deno test --allow-net --allow-env tests/contract_test.ts",
    "gen:openapi": "deno run --allow-net --allow-env --allow-read --allow-write scripts/dump-openapi.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "imports": {
    "@daloyjs/core": "jsr:@daloyjs/daloy@^1.5.4",
    "@daloyjs/core/banner": "jsr:@daloyjs/daloy@^1.5.4/banner",
    "@daloyjs/core/contract": "jsr:@daloyjs/daloy@^1.5.4/contract",
    "@daloyjs/core/deno": "jsr:@daloyjs/daloy@^1.5.4/deno",
    "@daloyjs/core/openapi": "jsr:@daloyjs/daloy@^1.5.4/openapi",
    "zod": "npm:zod@^4.4.3"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "fmt": {
    "lineWidth": 100
  }
}
