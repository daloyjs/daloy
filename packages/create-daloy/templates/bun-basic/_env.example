# Copy to .env for local use (Bun loads .env automatically). Real secrets
# belong in your platform's secret store, never in git (.env is git-ignored).
PORT=3000

# Number of reverse-proxy hops in front of the app (load balancer, PaaS edge,
# CDN). Required in production behind any proxy: without it DaloyJS refuses
# forwarded headers and answers 500. rateLimit() also uses it to key each
# client instead of the proxy. Leave unset when clients connect directly.
# TRUST_PROXY_HOPS=1

# Public base URL, used as the OpenAPI `servers` entry (no localhost default).
# PUBLIC_URL=https://api.example.com
