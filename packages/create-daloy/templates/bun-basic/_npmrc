# DaloyJS supply-chain hardening defaults.
#
# pnpm is this template's default package manager (Bun is the runtime).
# When you scaffold with `--package-manager bun` the CLI removes this file
# and writes bunfig.toml with the same 24h cooldown instead.
#
# pnpm 11+ reads its settings from pnpm-workspace.yaml, not from this file,
# so the same values are set there. They stay here for npm and older tooling.

auto-install-peers=true
strict-peer-dependencies=true
prefer-frozen-lockfile=true
verify-store-integrity=true
minimum-release-age=1440
ignore-scripts=true
